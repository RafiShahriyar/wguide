{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuideForge",
  "version": "0.1.0",
  "identifier": "com.guideforge.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "GuideForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/guideforge-backend"]
  }
}
